%% ======== EDB: derived predicate facts, real timeline ======== %%

@input("isPositiveCorrelation").
@bind("isPositiveCorrelation","csv useHeaders=true, delimiter=',',nullString='NULL', quoteMode='MINIMAL', recordSeparator='\n'","${R}","edb_isPositiveCorrelation.csv").
@mapping("isPositiveCorrelation",0,"X","string").
@mapping("isPositiveCorrelation",1,"Y","string").
@mapping("isPositiveCorrelation",2,"Start","int").
@mapping("isPositiveCorrelation",3,"End","int").
@temporalMappings("isPositiveCorrelation",2,3,-1,-1,"[_,_)").

@input("tailDependent").
@bind("tailDependent","csv useHeaders=true, delimiter=',',nullString='NULL', quoteMode='MINIMAL', recordSeparator='\n'","${R}","edb_tailDependent.csv").
@mapping("tailDependent",0,"X","string").
@mapping("tailDependent",1,"Y","string").
@mapping("tailDependent",2,"Start","int").
@mapping("tailDependent",3,"End","int").
@temporalMappings("tailDependent",2,3,-1,-1,"[_,_)").

%% ======== MINED RULE UNDER VERIFICATION ======== %%
% template : T2b_contagion_bw
% pair     : sp500_gold
% constants: {'w': 1}
% fitted on: 2015-01-01..2021-12-31
contagionBw(X,Y) :- isPositiveCorrelation(X,Y), <->[0,1] tailDependent(X,Y).

@output("contagionBw").
@bind("contagionBw","csv useHeaders=true, delimiter=',',nullString='NULL', quoteMode='MINIMAL', recordSeparator='\n'","${R}","contagionBw_${I}.csv").
@mapping("contagionBw",0,"X","string").
@mapping("contagionBw",1,"Y","string").
@mapping("contagionBw",2,"Start","int").
@mapping("contagionBw",3,"End","int").
@temporalMappings("contagionBw",2,3,-1,-1,"[_,_]").

%% ======== ANNOTATIONS ======== %%

@timeGranularity("no_date").
@temporalType("int").

@library("math:","math").
