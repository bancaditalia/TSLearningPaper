@output("trendUp").
@bind("trendUp","csv useHeaders=true, delimiter=',',nullString='NULL', quoteMode='MINIMAL', recordSeparator='\n'","${R}","trendUp_${I}.csv").
@mapping("trendUp",0,"X","string").
@mapping("trendUp",1,"Sum","double").
@mapping("trendUp",2,"Start","int").
@mapping("trendUp",3,"End","int").
@temporalMappings("trendUp",2,3,-1,-1,"[_,_]").

@output("trendDown").
